# Copie valores individualmente para o ambiente staging do Coolify; este arquivo é só referência.
# ENV: obrigatória | segredo: não | tipo: runtime
ENV=staging
# MONGO_URL: obrigatória | segredo: sim (credenciais) | tipo: runtime
MONGO_URL=mongodb://staging_user:REPLACE_WITH_PASSWORD@mongo-internal:27017/trilhacode_staging?authSource=admin
# DB_NAME: obrigatória | segredo: não | tipo: runtime
DB_NAME=trilhacode_staging
# JWT_SECRET: obrigatória | segredo: sim | tipo: runtime
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# FRONTEND_URL: obrigatória | segredo: não | tipo: runtime
FRONTEND_URL=https://app.staging.example.invalid
# CORS_ORIGINS: obrigatória | segredo: não | tipo: runtime
CORS_ORIGINS=https://app.staging.example.invalid
# COOKIE_DOMAIN: opcional (recomendado para subdomínios) | segredo: não | tipo: runtime
COOKIE_DOMAIN=.staging.example.invalid
# COOKIE_SAMESITE: opcional (padrão Lax) | segredo: não | tipo: runtime
COOKIE_SAMESITE=Lax
# COOKIE_SECURE: opcional (padrão: ligado em HTTPS/production) | segredo: não | tipo: runtime
COOKIE_SECURE=true
# TRUSTED_PROXY_IPS: obrigatória atrás do proxy; informe IP/CIDR do proxy Coolify | segredo: não | tipo: runtime e forwarded headers
TRUSTED_PROXY_IPS=127.0.0.1
# Configure entrega SMTP antes de homologar cadastro/recuperação em staging.
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.invalid
SMTP_STARTTLS=true
SMTP_SSL=false
LOCAL_EMAIL_DIR=.local-emails
# ADMIN_EMAIL: obrigatória para criação idempotente do primeiro admin via seed | segredo: não | tipo: runtime
ADMIN_EMAIL=admin@example.invalid
# ADMIN_PASSWORD: obrigatória para criação idempotente do primeiro admin via seed | segredo: sim | tipo: runtime
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_LONG_PASSWORD
# SENTRY_DSN: opcional | segredo: não (DSN de ingestão público) | tipo: runtime API
SENTRY_DSN=
# SENTRY_ENVIRONMENT: opcional | segredo: não | tipo: runtime API
SENTRY_ENVIRONMENT=staging
# SENTRY_RELEASE: opcional | segredo: não | tipo: runtime API
SENTRY_RELEASE=
# WEB_CONCURRENCY: opcional (padrão 1) | segredo: não | tipo: runtime
WEB_CONCURRENCY=1
# PORT: opcional (padrão 8000) | segredo: não | tipo: runtime
PORT=8000
# VITE_BACKEND_URL: obrigatória | segredo: não | tipo: build frontend (marcar como build variable no Coolify)
VITE_BACKEND_URL=https://api.staging.example.invalid
# VITE_SENTRY_DSN: opcional | segredo: não (DSN público) | tipo: build frontend
VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT: opcional | segredo: não | tipo: build frontend
VITE_SENTRY_ENVIRONMENT=staging
# VITE_SENTRY_RELEASE: opcional | segredo: não | tipo: build frontend
VITE_SENTRY_RELEASE=
