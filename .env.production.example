# Copie valores individualmente para o ambiente production do Coolify; este arquivo é só referência.
# ENV: obrigatória | segredo: não | tipo: runtime
ENV=production
# MONGO_URL: obrigatória | segredo: sim (credenciais) | tipo: runtime
MONGO_URL=mongodb://production_user:REPLACE_WITH_PASSWORD@mongo-internal:27017/trilhacode_production?authSource=admin
# DB_NAME: obrigatória | segredo: não | tipo: runtime
DB_NAME=trilhacode_production
# JWT_SECRET: obrigatória | segredo: sim, aleatório >=32 caracteres; nunca usar o marcador de exemplo | tipo: runtime
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# FRONTEND_URL: obrigatória | segredo: não | tipo: runtime
FRONTEND_URL=https://app.example.invalid
# CORS_ORIGINS: obrigatória | segredo: não | tipo: runtime
CORS_ORIGINS=https://app.example.invalid
# COOKIE_DOMAIN: obrigatória em production | segredo: não | tipo: runtime
COOKIE_DOMAIN=.example.invalid
# COOKIE_SAMESITE: recomendada Lax | segredo: não | tipo: runtime
COOKIE_SAMESITE=Lax
# COOKIE_SECURE: obrigatória true em production | segredo: não | tipo: runtime
COOKIE_SECURE=true
# TRUSTED_PROXY_IPS: obrigatória atrás do proxy; informe IP/CIDR do proxy Coolify | segredo: não | tipo: runtime e forwarded headers
TRUSTED_PROXY_IPS=127.0.0.1
# EMAIL_TRANSPORT: obrigatório smtp; local é somente desenvolvimento/teste | segredo: não
EMAIL_TRANSPORT=smtp
# SMTP_HOST: hostname do relay de e-mail | segredo: não
SMTP_HOST=smtp.example.invalid
# SMTP_PORT: normalmente 587 com STARTTLS ou 465 com SSL | segredo: não
SMTP_PORT=587
# SMTP_USERNAME: opcional conforme o relay; deve ser definido junto com SMTP_PASSWORD | segredo: sim se usado
SMTP_USERNAME=
# SMTP_PASSWORD: opcional conforme o relay; deve ser definido junto com SMTP_USERNAME | segredo: sim se usado
SMTP_PASSWORD=
# SMTP_FROM_EMAIL: endereço remetente validado no provedor | segredo: não
SMTP_FROM_EMAIL=no-reply@example.invalid
# SMTP_STARTTLS: true em relay 587 | segredo: não
SMTP_STARTTLS=true
# SMTP_SSL: true em relay 465; não combinar com STARTTLS | segredo: não
SMTP_SSL=false
# LOCAL_EMAIL_DIR só existe para modo local de desenvolvimento/teste; não usar em production
LOCAL_EMAIL_DIR=.local-emails
# ADMIN_EMAIL: obrigatória em production | segredo: não | tipo: runtime
ADMIN_EMAIL=admin@example.invalid
# ADMIN_PASSWORD: obrigatória, única e forte (>=16 caracteres); nunca use o marcador de exemplo | segredo: sim | tipo: runtime
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_LONG_PASSWORD
# SENTRY_DSN: opcional | segredo: não (DSN de ingestão público) | tipo: runtime API
SENTRY_DSN=
# SENTRY_ENVIRONMENT: opcional | segredo: não | tipo: runtime API
SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE: opcional | segredo: não | tipo: runtime API
SENTRY_RELEASE=
# WEB_CONCURRENCY: opcional (padrão 1) | segredo: não | tipo: runtime
WEB_CONCURRENCY=1
# PORT: opcional (padrão 8000) | segredo: não | tipo: runtime
PORT=8000
# VITE_BACKEND_URL: obrigatória | segredo: não | tipo: build frontend (marcar como build variable no Coolify)
VITE_BACKEND_URL=https://api.example.invalid
# VITE_SENTRY_DSN: opcional | segredo: não (DSN público) | tipo: build frontend
VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT: opcional | segredo: não | tipo: build frontend
VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE: opcional | segredo: não | tipo: build frontend
VITE_SENTRY_RELEASE=
