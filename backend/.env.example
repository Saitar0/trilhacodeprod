# Backend local development example. Replace all values outside development.
ENV=development
MONGO_URL=mongodb://localhost:27017
DB_NAME=trilhacode_dev
JWT_SECRET=dev-only-change-this-secret
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
EMAIL_TRANSPORT=local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_SSL=false
LOCAL_EMAIL_DIR=.local-emails
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=development-only-change-me
EDITOR_EMAIL=editor@example.invalid
EDITOR_PASSWORD=development-only-change-me
STUDENT_EMAIL=student@example.invalid
STUDENT_PASSWORD=development-only-change-me
